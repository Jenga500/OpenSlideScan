# Give the logged-in user access to PIE / Reflecta slide scanners (DigitDia 4000/5000/6000,
# PowerSlide, ProScan, MF5000) so DiaScan can drive them without root.
# Install: sudo cp 60-diascan.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
SUBSYSTEM=="usb", ATTRS{idVendor}=="05e3", ATTRS{idProduct}=="014[2-9]", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="05e3", ATTRS{idProduct}=="014[ab]", MODE="0666", TAG+="uaccess"
